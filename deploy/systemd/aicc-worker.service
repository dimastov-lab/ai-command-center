# The headless worker under systemd (VOYN-W0-AICC-SRV-05).
#
# Install:
#   cp deploy/systemd/aicc-worker.service /etc/systemd/system/
#   systemctl daemon-reload && systemctl enable --now aicc-worker
#
# The unit assumes the host is already enrolled: /etc/aicc/worker.env carries
# AICC_PG_USER=<its aicc_w_* role> and the SCRAM secret produced at ticket
# redemption. Enrolment is an operator act — a worker cannot redeem its own
# ticket by design.

[Unit]
Description=AI Command Center headless worker
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=aicc-worker
Group=aicc-worker
EnvironmentFile=/etc/aicc/worker.env
WorkingDirectory=/opt/aicc
ExecStart=/opt/aicc/.venv/bin/python -m command_center.worker

# Exit codes are the daemon's interface: 2 = config refused (an operator's
# problem — restarting cannot cure a bad env file, so it is excluded from
# restart), 3 = DB unreachable (cured by time).
Restart=always
RestartSec=10s
RestartPreventExitStatus=2
# SIGTERM stops claiming and finishes the item in hand. The stop timeout
# outlives ONE visibility window — a handler that finishes within its first
# lease survives shutdown intact. A longer-running handler (heartbeats exist
# so they may) is abandoned at the timeout; that abandonment is safe by
# construction (reaper + stale-owner fence), it is just not free: the item
# re-runs elsewhere.
TimeoutStopSec=330s

# Containment: the worker executes claimed payloads and talks to PostgreSQL —
# nothing here needs privileges, a home, or a writable system.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
StateDirectory=aicc-worker

[Install]
WantedBy=multi-user.target
